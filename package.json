{
  "name": "tailwind-nextjs-starter-blog",
  "version": "2.4.0",
  "private": true,
  "scripts": {
    "start": "next dev",
    "dev": "cross-env INIT_CWD=$PWD next dev",
    "build": "cross-env INIT_CWD=$PWD next build && cross-env NODE_OPTIONS='--experimental-json-modules' node ./scripts/postbuild.mjs",
    "serve": "next start",
    "analyze": "cross-env ANALYZE=true next build",
    "audit:yarn-high": "node scripts/check-yarn-audit.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "validate:content": "node scripts/validate-content.mjs --mode frontmatter",
    "validate:content:built": "node scripts/validate-content.mjs --mode built",
    "check:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "check:image-budget": "node scripts/check-image-budget.mjs",
    "a11y:check": "node scripts/a11y-scan.mjs",
    "lint": "next lint --fix --dir pages --dir app --dir components --dir lib --dir layouts --dir scripts",
    "sync:structured-interview": "node ./scripts/sync-structured-interview.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@effect-ts/core": "^0.60.5",
    "@effect-ts/otel": "^0.15.1",
    "@opentelemetry/api": "1.9.0",
    "@headlessui/react": "2.2.9",
    "@next/bundle-analyzer": "15.5.28",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "body-scroll-lock": "^3.1.5",
    "contentlayer2": "0.5.8",
    "esbuild": "0.27.3",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "image-size": "2.0.3",
    "next": "15.5.28",
    "next-contentlayer2": "0.5.8",
    "next-themes": "^0.4.6",
    "pliny": "0.4.1",
    "postcss": "^8.5.32",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-citation": "^2.3.2",
    "rehype-katex": "^7.0.1",
    "rehype-katex-notranslate": "^1.1.4",
    "rehype-preset-minify": "7.0.1",
    "rehype-prism-plus": "^2.0.2",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.1.18",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.18.0",
    "brace-expansion": "1.1.21",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/mdx": "^2.0.13",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitest/coverage-v8": "^5.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.5.28",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "js-yaml": "4.3.2",
    "lint-staged": "^16.2.7",
    "playwright": "1.64.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "remark-mdx": "^3.1.1",
    "typescript": "^5.9.3",
    "vite": "^7",
    "vitest": "^5.0.5"
  },
  "resolutions": {
    "@typescript-eslint/parser/**/brace-expansion": "5.0.12",
    "@typescript-eslint/eslint-plugin/**/brace-expansion": "5.0.12",
    "**/minimatch/brace-expansion": "1.1.21",
    "**/postcss": "8.5.32",
    "**/svgo": "3.3.5",
    "**/flatted": "3.4.2",
    "**/micromatch/picomatch": "2.3.2",
    "**/anymatch/picomatch": "2.3.2",
    "**/readdirp/picomatch": "2.3.2",
    "**/vite/picomatch": "4.0.7",
    "**/vitest/picomatch": "4.0.7",
    "**/vite/tinyglobby/picomatch": "4.0.7",
    "**/protobufjs": "7.6.6",
    "**/@babel/plugin-transform-modules-systemjs": "7.29.8",
    "**/@grpc/grpc-js": "1.14.7",
    "gray-matter/js-yaml": "3.15.2",
    "pliny/js-yaml": "4.3.2",
    "**/ws": "7.5.11",
    "**/next/sharp": "0.35.5",
    "**/nanoid": "3.3.20",
    "**/browserslist": "4.29.5",
    "**/probe-image-size": "7.4.0",
    "**/source-map-js": "1.2.2",
    "**/form-data": "2.5.6",
    "**/@opentelemetry/api": "1.9.0",
    "**/@opentelemetry/propagator-jaeger": "2.9.0",
    "**/toml": "5.0.1",
    "**/zod": "4.6.6"
  },
  "overrides": {
    "postcss": "$postcss",
    "next": {
      "postcss": "$postcss",
      "sharp": "0.35.5"
    },
    "next@15.5.28": {
      "postcss": "8.5.32"
    },
    "minimatch@^3.0.3": {
      "brace-expansion": "1.1.21"
    },
    "minimatch@^10.0.0": {
      "brace-expansion": "5.0.12"
    },
    "brace-expansion": "$brace-expansion",
    "svgo": "3.3.5",
    "flatted": "3.4.2",
    "picomatch": "2.3.2",
    "vite": {
      "picomatch": "4.0.7",
      "tinyglobby": {
        "picomatch": "4.0.7"
      }
    },
    "vitest": {
      "picomatch": "4.0.7"
    },
    "protobufjs": "7.6.6",
    "@babel/plugin-transform-modules-systemjs": "7.29.8",
    "@grpc/grpc-js": "1.14.7",
    "js-yaml": "$js-yaml",
    "gray-matter": {
      "js-yaml": "3.15.2"
    },
    "pliny@0.4.1": {
      "js-yaml": "4.3.2",
      "probe-image-size": "7.4.0"
    },
    "ws": "7.5.11",
    "sharp": "0.35.5",
    "nanoid": "3.3.20",
    "browserslist": "4.29.5",
    "source-map-js": "1.2.2",
    "form-data": "2.5.6",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/propagator-jaeger": "2.9.0",
    "toml": "5.0.1",
    "zod": "4.6.6"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "npx eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "npx prettier --write"
    ]
  }
}
